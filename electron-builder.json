{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "org.23code.enterprise",
  "productName": "23 Code Enterprise",
  "directories": { "output": "release" },
  "files": ["dist/**/*", "electron/**/*", "package.json", "!node_modules/@monaco-editor/**/*", "!node_modules/monaco-editor/**/*", "!node_modules/lucide-react/**/*", "!node_modules/react/**/*", "!node_modules/react-dom/**/*", "!node_modules/@xterm/**/*"],
  "asar": true,
  "asarUnpack": ["node_modules/@lydell/**/*", "node_modules/pyright/**/*"],
  "npmRebuild": false,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
    "icon": "build/icon.ico",
    "executableName": "23 Code Enterprise"
  },
  "nsis": {
    "artifactName": "23-Code-Enterprise-Setup-${version}-${arch}.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "23 Code Enterprise",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "23-Code-Enterprise-Portable-${version}-${arch}.${ext}",
    "requestExecutionLevel": "user"
  }
}
