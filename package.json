{
  "name": "23-code-enterprise",
  "private": true,
  "version": "0.4.0",
  "description": "A local-first, VS Code-style editor for desktop and browser",
  "main": "electron/main.cjs",
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "desktop:setup": "node node_modules/electron/install.js",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && node scripts/create-icon.cjs && node scripts/prepare-opencode.cjs && electron-builder --win --x64 --publish never",
    "package:win:dir": "npm run build && node scripts/create-icon.cjs && node scripts/prepare-opencode.cjs && electron-builder --win --x64 --dir --publish never",
    "test:packaged": "node scripts/test-packaged.cjs",
    "languages:update": "node scripts/update-language-catalog.cjs",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@monaco-editor/react": "^4.6.0",
    "@opencode/client": "2.0.31",
    "@xterm/xterm": "^6.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.344.0",
    "monaco-editor": "^0.57.0",
    "pyright": "^1.1.410",
    "semver": "^7.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-monaco": "^0.1.5",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.12",
    "zustand": "^4.5.2",
    "yauzl": "^3.4.0"
  },
  "overrides": { "dompurify": "^3.4.17", "@electron/get": { "global-agent": "^4.1.3" } },
  "devDependencies": {
    "shiki": "4.5.0",
    "yaml": "^2.8.1",
    "@opencode/cli": "2.0.31",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.4"
  }
}
